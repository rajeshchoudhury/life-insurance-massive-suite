#!/usr/bin/env bash
set -euo pipefail
MVN_VERSION=3.9.9
BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
mkdir -p "$WRAPPER_DIR"
JAR="$WRAPPER_DIR/maven-wrapper.jar"
PROPS="$WRAPPER_DIR/maven-wrapper.properties"
if [ ! -f "$PROPS" ]; then
  cat > "$PROPS" <<EOF
wrapperUrl=https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/${MVN_VERSION}/maven-wrapper-${MVN_VERSION}.jar
EOF
fi
if [ ! -f "$JAR" ]; then
  curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/${MVN_VERSION}/maven-wrapper-${MVN_VERSION}.jar" -o "$JAR"
fi
exec java -jar "$JAR" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" "$@"
